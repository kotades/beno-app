          "text": "Frequently Asked Questions"
        },
        {
          "tag": "H3",
          "text": "What is Beno?"
        },
        {
          "tag": "H3",
          "text": "What services does Beno offer worldwide?"
        },
        {
          "tag": "H3",
          "text": "Does Beno have a mobile app?"
        },
        {
          "tag": "H3",
          "text": "What payment methods does Beno accept?"
